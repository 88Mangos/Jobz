*.moved-aside
*.xcscmblueprint

# Xcode Workspace & Scheme settings
!*.xcodeproj/project.xcworkspace
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata
!*.xcworkspace/xcshareddata/

# Swift Package Manager
.build/
.swiftpm/
Packages/

# Scratch & Temporary Build Artifacts
scratch/
*.tmp
*.log
