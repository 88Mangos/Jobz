# macOS & OS X System Files
.DS_Store
.AppleDouble
.LSOverride
._*
.Trashes

# Xcode
#
# Reference: Xcode / Swift standard gitignore
build/
DerivedData/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
